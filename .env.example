# ---- shared ----
APP_ENV=local                      # local | dev | prod
LOG_LEVEL=INFO

# ---- api / worker (server only) ----
# API: connect as po_api (ADR 0003), never as postgres. Local: postgresql://po_api:po_api_local_only@127.0.0.1:54322/postgres
DATABASE_URL=                      # required outside local; postgresql://... (asyncpg driver added automatically)
DATABASE_CA_CERT=                  # required outside local: Supabase CA PEM (Dashboard → Database → SSL); DB TLS is verify-full
SUPABASE_URL=                      # required outside local; origin only, e.g. http://127.0.0.1:54321 (JWKS + JWT issuer)
WEB_ORIGIN=http://localhost:3000   # required outside local; the only CORS origin
WORKER_POLL_INTERVAL_SECONDS=1
SUPABASE_SECRET_KEY=               # sb_secret_...; server only (worker/admin), never in web. No JWT secret: tokens are verified via JWKS
STORAGE_BUCKET=documents
# LLM (ADR 0011): only the worker and `evals --live` need these; the api service never does.
LLM_PROVIDER=anthropic                # anthropic | fake (fake: APP_ENV=local only, refused when deployed)
LLM_API_KEY=                          # secret; Railway: worker service only. Local: repo-root .env (gitignored)
LLM_EXTRACTION_MODEL=                 # e.g. claude-sonnet-5-5 (model ids come from env only)
LLM_MAPPING_MODEL=                    # e.g. claude-haiku-5-5 (spreadsheet column mapping, PR 5)
LLM_TIMEOUT_SECONDS=600               # per attempt; must be ≥ 3600 × max tokens / 128000 (a full reply)
LLM_MAX_RETRIES=2                     # transport retries (429/5xx/timeouts), honours retry-after
LLM_MAX_OUTPUT_TOKENS=16000
LLM_EFFORT=medium                     # low | medium | high | xhigh | max (tuned with evals in PR 9)
# Never set ANTHROPIC_BASE_URL / ANTHROPIC_CUSTOM_HEADERS / ANTHROPIC_LOG: the worker refuses to start.
LLM_EMBEDDING_PROVIDER=
LLM_EMBEDDING_MODEL=
SENTRY_DSN_API=
INBOUND_EMAIL_WEBHOOK_SECRET=

# ---- operator tools (apps/api/tools; set in your shell only, NEVER in an app/.env file) ----
# ADMIN_SUPABASE_URL=              # project origin; non-local needs --confirm-host (runbook: invite-pilot-user)
# ADMIN_SUPABASE_SECRET_KEY=       # sb_secret_...; paste into the shell session, never commit

# ---- web (public values only) ----
NEXT_PUBLIC_SUPABASE_URL=                 # local: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=     # sb_publishable_... (`supabase status`); never the secret key
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SENTRY_DSN=
