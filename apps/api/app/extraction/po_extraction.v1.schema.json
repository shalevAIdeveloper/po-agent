{
  "$defs": {
    "Address": {
      "additionalProperties": false,
      "properties": {
        "raw_text": {
          "minLength": 1,
          "title": "Raw Text",
          "type": "string"
        },
        "name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Name"
        },
        "attention": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Attention"
        },
        "line1": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Line1"
        },
        "line2": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Line2"
        },
        "city": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "City"
        },
        "state": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "State"
        },
        "postal_code": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Postal Code"
        },
        "country": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Country"
        }
      },
      "required": [
        "raw_text",
        "name",
        "attention",
        "line1",
        "line2",
        "city",
        "state",
        "postal_code",
        "country"
      ],
      "title": "Address",
      "type": "object"
    },
    "PurchaseOrderHeader": {
      "additionalProperties": false,
      "properties": {
        "customer_name": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Customer Name"
        },
        "customer_po_number": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Customer Po Number"
        },
        "po_date_raw": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Po Date Raw"
        },
        "po_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Po Date"
        },
        "requested_ship_date_raw": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Requested Ship Date Raw"
        },
        "requested_ship_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Requested Ship Date"
        },
        "ship_to": {
          "anyOf": [
            {
              "$ref": "#/$defs/Address"
            },
            {
              "type": "null"
            }
          ]
        },
        "bill_to": {
          "anyOf": [
            {
              "$ref": "#/$defs/Address"
            },
            {
              "type": "null"
            }
          ]
        },
        "order_total": {
          "anyOf": [
            {
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Order Total"
        },
        "currency": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currency"
        },
        "payment_terms": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Payment Terms"
        },
        "notes": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Notes"
        }
      },
      "required": [
        "customer_name",
        "customer_po_number",
        "po_date_raw",
        "po_date",
        "requested_ship_date_raw",
        "requested_ship_date",
        "ship_to",
        "bill_to",
        "order_total",
        "currency",
        "payment_terms",
        "notes"
      ],
      "title": "PurchaseOrderHeader",
      "type": "object"
    },
    "PurchaseOrderLine": {
      "additionalProperties": false,
      "properties": {
        "raw_text": {
          "minLength": 1,
          "title": "Raw Text",
          "type": "string"
        },
        "line_no": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Line No"
        },
        "line_type": {
          "enum": [
            "product",
            "charge",
            "comment"
          ],
          "title": "Line Type",
          "type": "string"
        },
        "customer_part_number": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Customer Part Number"
        },
        "vendor_part_number": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Vendor Part Number"
        },
        "description": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Description"
        },
        "qty": {
          "anyOf": [
            {
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Qty"
        },
        "uom": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Uom"
        },
        "unit_price": {
          "anyOf": [
            {
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit Price"
        },
        "price_per": {
          "anyOf": [
            {
              "pattern": "^[1-9][0-9]{0,5}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Price Per"
        },
        "extended_price": {
          "anyOf": [
            {
              "pattern": "^-?[0-9]+(\\.[0-9]+)?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Extended Price"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Page"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "raw_text",
        "line_no",
        "line_type",
        "customer_part_number",
        "vendor_part_number",
        "description",
        "qty",
        "uom",
        "unit_price",
        "price_per",
        "extended_price",
        "page",
        "confidence"
      ],
      "title": "PurchaseOrderLine",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "po_extraction.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "document_type": {
      "enum": [
        "purchase_order",
        "not_a_po"
      ],
      "title": "Document Type",
      "type": "string"
    },
    "header": {
      "$ref": "#/$defs/PurchaseOrderHeader"
    },
    "header_confidence": {
      "maximum": 1,
      "minimum": 0,
      "title": "Header Confidence",
      "type": "number"
    },
    "lines": {
      "items": {
        "$ref": "#/$defs/PurchaseOrderLine"
      },
      "title": "Lines",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "document_type",
    "header",
    "header_confidence",
    "lines"
  ],
  "title": "PurchaseOrderExtraction",
  "type": "object"
}
