# Normalize line endings: LF in the repo and working tree, regardless of core.autocrlf.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binaries (PO fixtures, images, spreadsheets)
*.pdf  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.heic binary
*.xlsx binary
*.xls  binary
*.eml  -text
*.ico  binary
*.woff binary
*.woff2 binary

# Eval fixtures (M1 PR 6): sources are compared byte for byte (CSV CRLF / encodings, EML
# CRLF), so git must never normalize them, whatever their extension. `-text` stops
# normalization; `diff` keeps text diffs of CSV/EML reviewable (dev L7). Later lines win,
# so this overrides `*.pdf binary` etc. for these paths only (PDF/images still show as
# binary diffs: git detects NUL bytes).
apps/api/evals/fixtures/**/source.* -text diff
